APP_NAME="Priyam Finserv"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://priyamfinserv.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ───────────────────────────────────────────────────────────────────
# On Render: set DB_CONNECTION=pgsql and DATABASE_URL (auto-injected by Render)
# Locally: set DB_CONNECTION=mysql and fill DB_HOST/DB_DATABASE etc.
DB_CONNECTION=pgsql
DATABASE_URL=

# ── Session / Cache / Queue ────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Mail — Gmail SMTP ─────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=priyamfinserve@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="priyamfinserve@gmail.com"
MAIL_FROM_NAME="Priyam Finserv"
